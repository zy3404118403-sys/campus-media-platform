<view class="page">
  <view class="hdr">
    <view class="hdr-kicker">ITEMS</view>
    <view class="hdr-title">事项</view>
    <view class="hdr-sub">报名签到 · 领取任务 · 攒贡献值</view>
  </view>

  <view class="seg">
    <view
      class="seg-item {{tab === 'activity' ? 'on' : ''}}"
      data-tab="activity"
      bindtap="onSeg"
    >活动</view>
    <view
      class="seg-item {{tab === 'task' ? 'on' : ''}}"
      data-tab="task"
      bindtap="onSeg"
    >任务</view>
    <view
      class="seg-item {{tab === 'mine' ? 'on' : ''}}"
      data-tab="mine"
      bindtap="onSeg"
    >我的</view>
  </view>

  <!-- ══════════ 活动 ══════════ -->
  <block wx:if="{{tab === 'activity'}}">
    <view wx:if="{{aState === 'loading'}}">
      <view class="sk sk-short"></view>
      <view class="sk sk-short"></view>
      <view class="sk sk-short"></view>
    </view>

    <view wx:elif="{{aState === 'error'}}" class="state">
      <view class="state-mark ico ico-close"></view>
      <view class="state-title">活动加载失败</view>
      <view class="state-desc">请稍后重试</view>
      <view class="btn btn-ghost state-btn" bindtap="onRetryActivity">重新加载</view>
    </view>

    <view wx:elif="{{aState === 'empty'}}" class="state">
      <view class="state-mark ico ico-file"></view>
      <view class="state-title">暂时没有进行中的活动</view>
      <view class="state-desc">新活动发布后会出现在这里</view>
    </view>

    <block wx:else>
      <view
        wx:for="{{aList}}"
        wx:key="id"
        class="row"
        data-id="{{item.id}}"
        bindtap="onOpenActivity"
      >
        <view class="row-thumb {{item.tone}}"></view>
        <view class="row-main">
          <view class="row-title">{{item.title}}</view>
          <view class="row-desc">{{item.time}} · {{item.place}}</view>
          <view class="row-foot">
            <text class="{{item.state === '已结束' ? 'pill pill-mute' : 'pill'}}">{{item.state}}</text>
            <text>{{item.joined}} 人参与</text>
          </view>
          <view
            wx:if="{{item.state === '已结束'}}"
            class="btn btn-ghost row-btn row-btn-mute"
          >已结束</view>
          <view
            wx:elif="{{item.joined2}}"
            class="btn btn-ghost row-btn row-btn-done"
            data-id="{{item.id}}"
            catchtap="onCancel"
          >已报名 · 点击取消</view>
          <view
            wx:else
            class="btn row-btn"
            data-id="{{item.id}}"
            catchtap="onJoin"
          >立即报名</view>
        </view>
      </view>
    </block>
  </block>

  <!-- ══════════ 任务 ══════════ -->
  <block wx:elif="{{tab === 'task'}}">
    <view wx:if="{{tState === 'loading'}}">
      <view class="sk sk-short"></view>
      <view class="sk sk-short"></view>
    </view>

    <view wx:elif="{{tState === 'error'}}" class="state">
      <view class="state-mark ico ico-close"></view>
      <view class="state-title">任务加载失败</view>
      <view class="state-desc">请稍后重试</view>
      <view class="btn btn-ghost state-btn" bindtap="onRetryTask">重新加载</view>
    </view>

    <view wx:elif="{{tState === 'empty'}}" class="state">
      <view class="state-mark ico ico-file"></view>
      <view class="state-title">任务大厅正在筹备</view>
      <view class="state-desc">第一批校园拍摄与设计任务即将开放</view>
    </view>

    <block wx:else>
      <view
        wx:for="{{tList}}"
        wx:key="id"
        class="row"
        data-id="{{item.id}}"
        bindtap="onOpenTask"
      >
        <view class="row-thumb {{item.tone}}"></view>
        <view class="row-main">
          <view class="row-title">
            {{item.title}}
            <text wx:if="{{item.demo}}" class="demo-tag">演示</text>
          </view>
          <view class="row-desc">{{item.desc}}</view>
          <view class="row-foot">
            <text><text class="gold">{{item.points}}</text> 贡献值 · {{item.type}}</text>
            <text>{{item.slots}} · {{item.deadline}} 截止</text>
          </view>
          <view
            wx:if="{{item.claimed}}"
            class="btn btn-ghost row-btn row-btn-done"
            data-id="{{item.id}}"
            catchtap="onOpenTask"
          >已领取 · 去提交</view>
          <view
            wx:else
            class="btn row-btn"
            data-id="{{item.id}}"
            catchtap="onOpenTask"
          >查看并领取</view>
        </view>
      </view>

      <view class="note">标有「演示」的任务为功能体验用示例，非正式发布任务。</view>
    </block>
  </block>

  <!-- ══════════ 我的：报名与领取的汇总 ══════════ -->
  <block wx:else>
    <view wx:if="{{mEmpty}}" class="state">
      <view class="state-mark ico ico-file"></view>
      <view class="state-title">还没有参与任何事项</view>
      <view class="state-desc">在「活动」里报名，或在「任务」里领取，之后都会汇总到这里</view>
    </view>

    <block wx:else>
      <block wx:if="{{mActs.length}}">
        <view class="sec"><view class="sec-title">我报名的活动</view></view>
        <view
          wx:for="{{mActs}}"
          wx:key="id"
          class="row"
          data-id="{{item.id}}"
          bindtap="onOpenActivity"
        >
          <view class="row-thumb {{item.tone}}"></view>
          <view class="row-main">
            <view class="row-title">{{item.title}}</view>
            <view class="row-desc">{{item.time}} · {{item.place}}</view>
            <view class="row-foot">
              <text class="pill">{{item.state}}</text>
              <text>{{item.joined}} 人参与</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:if="{{mTasks.length}}">
        <view class="sec"><view class="sec-title">我领的任务</view></view>
        <view
          wx:for="{{mTasks}}"
          wx:key="id"
          class="row"
          data-id="{{item.id}}"
          bindtap="onOpenTask"
        >
          <view class="row-thumb {{item.tone}}"></view>
          <view class="row-main">
            <view class="row-title">{{item.title}}</view>
            <view class="row-desc">{{item.desc}}</view>
            <view class="row-foot">
              <text><text class="gold">{{item.points}}</text> 贡献值 · {{item.type}}</text>
              <text>{{item.deadline}} 截止</text>
            </view>
          </view>
        </view>
      </block>
    </block>
  </block>

  <view class="safe"></view>
</view>
