/* 图标库（由 audit/phase2/work/gen-icons-png.py 生成，勿手改）
 * 25 个线性图标，base64 PNG（官方明确支持的方式）
 *
 * 用法：
 *   <view class="ico ico-search"></view>              白色 #f4f6fa
 *   <view class="ico ico-search ico-dim2"></view>     降透明度 → 次文字观感
 *   <view class="ico ico-search ico-dim3"></view>     再降 → 弱文字观感
 *   <view class="ico ico-search-g"></view>            品牌金 #d8b46a
 * 尺寸：改 font-size 即可（width/height 都是 1em）
 */

.ico {
  display: inline-block;
  width: 1em;
  height: 1em;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  vertical-align: -0.12em;
  flex: none;
}
.ico-dim2 { opacity: 0.62; }
.ico-dim3 { opacity: 0.40; }

